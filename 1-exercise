#Exercise 1

#Define a function
f(x) = x**4-7*x**2+6*x

set terminal qt 0
set title "Exercise 1 - a"
set xlabel "x"
set ylabel "f(x)"
set xrange [-1:1]
set yrange [-1:1]
set key at 1, -0.7
plot f(x) with lines lw 2 lc rgb "blue" title "f(x) = x**4 + 7*x**2 + 6*x \n x-range [-1:1] \n y-range [-1:1]"

set terminal qt 1
set title "Exercise 1 - b"
set xlabel "x"
set ylabel "f(x)"
set xrange [-2:2]
set yrange [-5:5]
set key at 2, 4.5
plot f(x) with lines lw 2 lc rgb "red" title "f(x) = x**4 + 7*x**2 + 6*x \n x-range [-2:2] \n y-range [-5:5]"

set terminal qt 2
set title "Exercise 1 - c"
set xlabel "x"
set ylabel "f(x)"
set xrange [-10:10]
set yrange [-10:10]
set key at 10, -7.0
plot f(x) with lines lw 2 lc rgb "yellow" title "f(x) = x**4 + 7*x**2 + 6*x \n x-range [-10:10] \n y-range [-10:10]"

set terminal qt 3
set title "Exercise 1 - d"
set xlabel "x"
set ylabel "f(x)"
set xrange [-5:5]
set yrange [-25:15]
set key at 5, 2
plot f(x) with lines lw 2 lc rgb "green" title "f(x) = x**4 + 7*x**2 + 6*x \n x-range [-5:5] \n y-range [-25:15]"

pause -1

