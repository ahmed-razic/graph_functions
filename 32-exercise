#Define a function

set terminal qt 0
set grid
set xlabel "t"
set ylabel "sin(t), cos(t)"
set parametric
set size ratio 1
# set size square
# set xrange [0:2*pi]
# set yrange [-1:2]
plot [pi:2*pi] 3*cos(t) -1, 3*sin(t) + 2 with lines


set terminal qt 1
unset parametric
f1(x) = 2 + sqrt(8 - 2*x - x**2)
set grid
set xlabel "x"
set ylabel "f1(x)"
set xrange [-4:2]
# set yrange [-1:5]
set size ratio 1
plot f1(x) with lines


set terminal qt 2
f2(x) = 2 - sqrt(8 - 2*x - x**2)
set grid
set xlabel "x"
set ylabel "f2(x)"
set xrange [-4:2]
# set yrange [-1:5]
set size ratio 1
plot f2(x) with lines

pause -1
