#Define a function
f1(x) = sqrt( 1 + 16*x**2)
f2(x) = -sqrt( 1 + 16*x**2)

set terminal qt 1
set grid
set xlabel "x"
set ylabel "f1(x)"
set xrange [-0.5:0.5]
# set yrange [-1:5]
set size ratio 1
plot f1(x) with lines

set terminal qt 2
set grid
set xlabel "x"
set ylabel "f2(x)"
set xrange [-0.5:0.5]
# set yrange [-1:5]
set size ratio 1

plot f2(x) with lines

pause -1
#EOF