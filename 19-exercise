#Exercise 18
#Define a function
f(x) = (x**2 + 2)/(x**2 + 1)

set terminal qt 0
set grid
set xtics 2
set ytics 2
set xlabel "x"
set ylabel "f(x)"

set xrange [-5:5]
set yrange [-3:3]
set arrow from -10,0 to 10,0 lw 1 nohead
set arrow from 0,-10 to 0,10 lw 1 nohead

plot f(x) with lines

pause -1
